# ~/.config/diablo/local.env: the values that belong to this box, never to the repo.
# scripts/setup-local.sh writes it. Read by hub/localenv.py, the deploy scripts, the systemd
# units (EnvironmentFile) and the phone build. KEY=VALUE, one per line, mode 600.

# Where the hubs answer. Defaults are the MagicDNS names http://diablo-pi:8755 and
# http://nemurenai:8755; set the Tailscale IPs here if names do not resolve on a box.
DIABLO_HUB_URL=http://100.64.0.1:8755
DIABLO_STANDBY_URL=http://100.64.0.2:8755

# The address this box's hub binds to (diablo-hub and diablo-standby): its own `tailscale ip -4`.
DIABLO_HUB_BIND=100.64.0.1

# Found on their own when left out: the tailnet from `tailscale status`, the LAN from `ip route`.
#DIABLO_TAILNET=tailXXXXXX.ts.net
#DIABLO_HOME_SUBNET=192.168.1.0/24

# Optional overrides: the hub's local Whisper and the fleet viewer.
#DIABLO_STT_URL=http://banditbox:8757/v1
#DIABLO_FLEET_URL=http://nemurenai:8780

# Wake-on-LAN for the desktop box (send_wake).
#DIABLO_WOL_MAC=00:00:00:00:00:00

# Mail: name=address pairs himalaya knows, and the one agent address allowed to get replies.
#DIABLO_MAIL_ACCOUNTS=gmail=you@example.com,work=you@work.example
#DIABLO_MAIL_AGENT=agent@example.com

# Phone build: hosts the app may talk plain http to, besides the MagicDNS short names.
# Tailscale IPs and the tailnet suffix (tailXXXXXX.ts.net covers every name on it).
#DIABLO_CLEARTEXT_HOSTS=100.64.0.1,100.64.0.2,tailXXXXXX.ts.net

# Mail sorting hints, appended to the sort prompt.
#DIABLO_MAIL_HINTS="Mail from my school office is important."

# Hosts beyond the house fleet, and a note for each (host=note;host=note).
#DIABLO_FLEET_EXTRA=workbox
#DIABLO_FLEET_NOTES="workbox=needs the VPN up first"
