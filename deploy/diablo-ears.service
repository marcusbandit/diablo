[Unit]
Description=Diablo ears: say his name, he listens, he answers
After=graphical-session.target pipewire.service gvoice.service
PartOf=graphical-session.target
Wants=pipewire.service

[Service]
WorkingDirectory=%h/Projects/diablo
Environment=ORT_LOGGING_LEVEL=3
ExecStart=%h/Projects/diablo/.venv-voice/bin/python -m voice.ears run
Restart=always
RestartSec=3
MemoryMax=1500M
MemorySwapMax=0

[Install]
WantedBy=graphical-session.target
