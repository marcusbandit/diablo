def agent(resume=None):
    import shutil
    import subprocess

    rust_tui = shutil.which("diablo-tui")
    if rust_tui:
        args = [rust_tui]
        if resume == "last":
            args.append("-c")
        elif resume == "menu":
            args.append("-r")
        return subprocess.call(args)
    env = {**os.environ, "DIABLO_AGENT_CWD": os.getcwd()}
    if resume:
        env["DIABLO_AGENT_RESUME"] = resume
    return subprocess.call(
        [sys.executable, "-m", "pool.repl"], cwd=str(Path.home() / "Projects/diablo"), env=env
    )


