def load_config():
    cfg = dict(DEFAULTS)
    raw = {}
    if CONFIG_FILE.exists():
        try:
            raw = tomllib.loads(CONFIG_FILE.read_text())
            cfg.update(raw)
        except tomllib.TOMLDecodeError as e:
            print(f"pushup: ignoring broken {CONFIG_FILE}: {e}", file=sys.stderr)
    if (cfg["interval_min"], cfg["interval_max"]) == (25, 35):
        # The old defaults, written out by save_config before the interval grew. Not a choice.
        cfg["interval_min"], cfg["interval_max"] = DEFAULTS["interval_min"], DEFAULTS["interval_max"]
    cfg["interval_min"], cfg["interval_max"] = sorted((cfg["interval_min"], cfg["interval_max"]))
    cfg["reps_min"], cfg["reps_max"] = sorted((cfg["reps_min"], cfg["reps_max"]))
    # Names the catalog doesn't know (pull-ups, once there's a bar) stay: they get a plain figure
    # and push-up sized goals.
    cfg["exercises"] = [e for e in cfg["exercises"] if isinstance(e, str) and e] or ["push-ups"]
    cfg["stretches"] = [e for e in cfg["stretches"] if e in STRETCHES] or list(catalog.MIXED_STRETCHES)
    if "gear" not in raw:
        # From before gear was asked: someone who switched on a move that needs some has the everyday
        # tool for it, the last one listed: two chairs for dips, not dip bars.
        cfg["gear"] = [t for t in catalog.TOOLS if any(catalog.GEAR[e][-1] == t for e in cfg["exercises"] if e in catalog.GEAR)]
    cfg["gear"] = [t for t in catalog.TOOLS if t in cfg["gear"]]
    cfg.pop("snooze_minutes", None)
    return cfg


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = ["# pushup settings. Minutes for intervals, reps per set.", ""]
    for key, value in cfg.items():
        if isinstance(value, bool):
            lines.append(f"{key} = {'true' if value else 'false'}")
        elif isinstance(value, list):
            lines.append(f"{key} = [" + ", ".join(json.dumps(v) for v in value) + "]")
        else:
            lines.append(f"{key} = {json.dumps(value)}")
    CONFIG_FILE.write_text("\n".join(lines) + "\n")


def read_float(path):
    try:
        return float(path.read_text().strip())
    except (OSError, ValueError):
        return 0.0


def write_text(path, text):
    """Whole or not at all: a temp file per process, then one rename, so two writers never share a
    half-written file and Syncthing never ships one."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    tmp.replace(path)


def log_event(refresh=True, **fields):
    """Append a line to the log. refresh=False leaves the overview for the last of a batch."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(json.dumps({"ts": time.time(), **fields}) + "\n")
    if refresh:
        refresh_overview()


def read_local():
    """This box's own log, as written."""
    out = []
    if LOG.exists():
        for line in LOG.read_text().splitlines():
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return out


def read_log():
    """This box's log, plus what other devices added through the inbox, in time order."""
    out = read_local()
    inbox = read_inbox(out)
    return sorted(out + inbox, key=lambda e: e.get("ts", 0)) if inbox else out


INBOX_SINCE = dt.datetime(2020, 1, 1).timestamp()  # older than this is a broken clock, not training
INBOX_MAX = {"minutes": 24 * 60, "did": 1000}  # a day of training, a thousand reps or seconds


def inbox_entry(e, now):
    """One inbox line as a log entry, or None when it isn't one: a training session or a set done
    away from the desk, at a real time that has already happened, with sane numbers. Names go
    through the catalog's aliases ('rows' is body rows); an activity this box doesn't know counts
    as other under its own name."""
    if not isinstance(e, dict):
        return None
    ts = e.get("ts")
    if isinstance(ts, bool) or not isinstance(ts, (int, float)) or not math.isfinite(ts) or not INBOX_SINCE <= ts <= now:
        return None
    out = {k: v for k, v in e.items() if isinstance(v, (str, int, float)) and not isinstance(v, bool)}
    out["ts"] = float(ts)
    for key in ("id", "source", "label"):
        if key in out and not isinstance(out[key], str):
            del out[key]
    if e.get("result") == "session":
        minutes = e.get("minutes")
        if isinstance(minutes, bool) or not isinstance(minutes, (int, float)) or not math.isfinite(minutes) \
                or not 0 < minutes <= INBOX_MAX["minutes"] or not isinstance(e.get("activity"), str):
            return None
        out["minutes"] = max(1, int(round(minutes)))
        out["effort"] = e.get("effort") if e.get("effort") in EFFORT else "normal"
        if e["activity"] not in ACTIVITIES:
            out["label"] = out.get("label") or e["activity"]
            out["activity"] = "other"
        return out
    if e.get("result") == "manual":
        n = e.get("did")
        if isinstance(n, bool) or not isinstance(n, int) or not 0 < n <= INBOX_MAX["did"] or not isinstance(e.get("exercise"), str):
            return None
        out["exercise"] = catalog.find(e["exercise"]) or e["exercise"]
        return out
    return None


def read_inbox(local=()):
    """Training and sets other devices put in pushup-inbox/*.jsonl, one file per writer, as log
    entries (inbox_entry). An id counts once across every file, and a session this box already has
    (the same activity on the same day, logged with `pushup train`) counts once too. Every entry
    says where it came from."""
    if not INBOX.is_dir():
        return []
    have = {(e.get("activity"), day_of(e["ts"])) for e in local
            if e.get("result") == "session" and isinstance(e.get("ts"), (int, float))}
    out, seen, now = [], set(), time.time()
    for path in sorted(INBOX.glob("*.jsonl")):
        try:
            lines = path.read_text().splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        for line in lines:
            try:
                e = inbox_entry(json.loads(line), now)
            except ValueError:
                continue
            if e is None:
                continue
            key = e.get("id") or (round(e["ts"]), e["result"], e.get("activity") or e.get("exercise"))
            if key in seen or (e["result"] == "session" and (e["activity"], day_of(e["ts"])) in have):
                continue
            seen.add(key)
            out.append({**e, "source": e.get("source") or path.stem})
    return out


def overview(entries=None, now=None):
    """What nemurenai gets to show without knowing anything about pushup: today, the streak, the
    week on the body, four weeks by muscle group, and the challenge. Pure JSON, schema in
    docs/sync.md."""
    now = time.time() if now is None else now
    entries = read_log() if entries is None else entries
    cfg = load_config()
    day = day_of(now)
    sets = done_on(day, entries)
    last = last_set(entries)
    out = {"schema": OVERVIEW_SCHEMA, "generated": now, "day": day.isoformat(), "mode": cfg["mode"],
           "today": {"sets": len(sets), "line": day_line(sets),
                     "trained": [catalog.describe(e) for e in catalog.sessions(entries) if day_of(e["ts"]) == day]},
           "streak": day_streak(entries),
           "last": {"ts": last["ts"], "exercise": exercise_of(last), "did": did(last)} if last else None,
           "week": muscle_args(entries, now), "timeline": stats.timeline(entries, day_of, day), "challenge": None}
    if challenge_on(cfg):
        c = challenge(cfg, entries, now)
        out["challenge"] = {k: c[k] for k in ("day", "days", "start", "done", "target", "left", "deadline", "bss", "rows",
                                               "feet_up", "stretching", "history", "trained")}
    return out


def refresh_overview(entries=None):
    """Write overview.json for nemurenai. Never in the way of logging: a failure only says so, and
    returns False."""
    try:
        write_text(OVERVIEW, json.dumps(overview(entries)))
        return True
    except Exception as e:  # noqa: BLE001 - logging must not fail on the export
        print(f"pushup: overview not written: {e}", file=sys.stderr)
        return False


def day_of(ts):
    """The day a moment belongs to. It runs until DAY_ROLL, so a set at 01:00 or 04:00 counts for the evening before."""
    return (dt.datetime.fromtimestamp(ts) - dt.timedelta(hours=DAY_ROLL)).date()


def today():
    return day_of(time.time())


def day_end_ts(day):
    """When a day's push-ups should be done by: day_ends that evening, or the night after when it's
    an hour past midnight."""
    after = day + dt.timedelta(days=1) if DAY_END < DAY_ROLL else day
    return dt.datetime.combine(after, dt.time(DAY_END)).timestamp()


did = catalog.did


exercise_of = catalog.exercise_of


def done_on(day, entries=None):
    """The sets done on a day as (exercise, reps or seconds), oldest first, stretches included."""
    entries = read_log() if entries is None else entries
    return [(exercise_of(e), did(e)) for e in entries if did(e) > 0 and day_of(e["ts"]) == day]


def history(days, entries=None):
    """Sets per day, oldest first. Reps of different exercises don't add up to anything, sets do."""
    entries = read_log() if entries is None else entries
    totals = {}
    for e in entries:
        if did(e) > 0:
            day = day_of(e["ts"])
            totals[day] = totals.get(day, 0) + 1
    now = today()
    return [totals.get(now - dt.timedelta(days=i), 0) for i in range(days - 1, -1, -1)]


def day_line(sets):
    """'3 sets: 27 push-ups in 2 sets, 45 seconds of plank'."""
    if not sets:
        return "no sets yet"
    return f"{catalog.plural(len(sets), 'set')}: {', '.join(catalog.day_lines(sets))}"


def day_streak(entries):
    """Days in a row with reps or training, back from today, or from yesterday while today is still empty."""
    days = {day_of(e["ts"]) for e in entries if did(e) > 0 or e.get("result") == "session"}
    day = today()
    if day not in days:
        day -= dt.timedelta(days=1)
    n = 0
    while day in days:
        n += 1
        day -= dt.timedelta(days=1)
    return n


def last_set(entries=None):
    entries = read_log() if entries is None else entries
    return next((e for e in reversed(entries) if did(e) > 0), None)


def skip_streak(entries=None):
    """Skips in a row since the last set that had any reps in it, or the last training session."""
    entries = read_log() if entries is None else entries
    n = 0
    for e in reversed(entries):
        if did(e) > 0 or e.get("result") == "session":
            break
        if e.get("result") in ("skip", "done"):
            n += 1
    return n


def record_args(entries=None, days=14, week=None, with_stats=True):
    entries = read_log() if entries is None else entries
    last = last_set(entries)
    return ["--skips", str(skip_streak(entries)), "--history", ",".join(map(str, history(days, entries))),
            "--last", str(last["ts"] if last else 0), "--last-reps", str(did(last) if last else 0),
            "--last-exercise", exercise_of(last) if last else "push-ups",
            "--muscles", json.dumps(muscle_args(entries, week=week)),
            "--done", json.dumps(done_on(today(), entries))] + (
            # The receipts' days follow `pushup graph N`; the strength numbers need two weeks.
            ["--stats", json.dumps(stats.build(entries, day_of, today(), max(14, days)))] if with_stats else [])


def recent_sets(entries):
    """What you logged last of each exercise, as {exercise: [reps, sets]}, so the logging card
    starts there. Sets logged in one go share a moment, so only same-sized manual sets within a few
    seconds of the last one count together. A set from a card is always one."""
    out = {}
    for e in reversed(entries):
        if e.get("result") not in ("done", "manual") or did(e) <= 0:
            continue
        name = exercise_of(e)
        if name not in out:
            out[name] = [did(e), 1, e["ts"], e.get("result") == "manual"]
        elif out[name][3] and e.get("result") == "manual" and did(e) == out[name][0] and out[name][2] - e["ts"] < 5:
            out[name][1] += 1
        else:
            out[name][3] = False  # the run of sets is over; older ones don't join it
    return {name: v[:2] for name, v in out.items()}


def muscle_args(entries, now=None, week=None):
    """The week on the body: what each muscle got, for the maps, and the raw totals."""
    work, stretch, raw_w, raw_s = week or catalog.muscle_week(entries, time.time() if now is None else now)
    return {"work": work, "stretch": stretch, "work_raw": raw_w, "stretch_raw": raw_s,
            "neglected": catalog.neglected(raw_w)}


def fmt_clock(ts):
    return dt.datetime.fromtimestamp(ts).strftime("%H:%M")


def fmt_left(seconds):
    seconds = max(0, int(seconds))
    d, rem = divmod(seconds, 86400)
    h, rem = divmod(rem, 3600)
    m, s = divmod(rem, 60)
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m:02d}m"
    if m:
        return f"{m}m {s:02d}s"
    return f"{s}s"


def hypr_env():
    env = dict(os.environ)
    try:
        instances = json.loads(subprocess.run(["hyprctl", "instances", "-j"], capture_output=True, text=True, timeout=3).stdout)
        if instances:
            newest = max(instances, key=lambda i: i.get("time", 0))
            env["HYPRLAND_INSTANCE_SIGNATURE"] = newest["instance"]
            env["WAYLAND_DISPLAY"] = newest["wl_socket"]
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return env


def run(cmd, env=None, timeout=5):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def discord_pids():
    pids = set()
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            comm = (proc / "comm").read_text().strip().lower()
        except OSError:
            continue
        if any(n in comm for n in DISCORD_NAMES):
            pids.add(proc.name)
    return pids


def discord_call():
    """A Discord client holding a microphone stream means it is in a voice call."""
    try:
        objects = json.loads(run(["pw-dump"], timeout=5) or "[]")
    except ValueError:
        return None
    pids = discord_pids()
    for obj in objects:
        props = (obj.get("info") or {}).get("props") or {}
        media_class = props.get("media.class", "")
        if not media_class.startswith("Stream/Input/Audio") or "Internal" in media_class:
            continue
        hay = " ".join(str(props.get(k, "")) for k in (
            "application.name", "application.process.binary", "application.id", "node.name", "client.name",
        )).lower()
        if any(n in hay for n in DISCORD_NAMES) or str(props.get("application.process.id", "")) in pids:
            return props.get("application.name") or props.get("application.process.binary") or "Discord"
    return None


def session_locked():
    # Hyprland started from a tty shows up in logind as Type=tty, so any active session counts.
    fake = os.environ.get("PUSHUP_FAKE_LOCK")
    if fake:
        return Path(fake).exists()
    user = os.environ.get("USER", "")
    rows = (line.split() for line in run(["loginctl", "list-sessions", "--no-legend"]).splitlines())
    ids = [row[0] for row in rows if len(row) >= 3 and row[2] == user]
    if not ids:
        return False
    props = run(["loginctl", "show-session", *ids, "-p", "LockedHint", "-p", "Active"])
    return any("Active=yes" in block and "LockedHint=yes" in block for block in props.split("\n\n"))


def players():
    out = []
    for name in run(["playerctl", "-l"]).split():
        status = run(["playerctl", "-p", name, "status"]).strip()
        meta = run(["playerctl", "-p", name, "metadata", "--format", "{{xesam:url}}\t{{xesam:title}}"]).strip()
        url, _, title = meta.partition("\t")
        out.append({"name": name, "status": status, "url": url, "title": title, "music": is_music(name, url)})
    return out


def is_music(name, url):
    base = name.split(".")[0].lower()
    if any(base.startswith(p) for p in MUSIC_PLAYERS):
        return True
    low = url.lower()
    if any(site in low for site in MUSIC_SITES):
        return True
    return low.startswith("file://") and low.endswith(AUDIO_EXT)


def pretty_player(p):
    base = p["name"].split(".")[0]
    if "youtube.com" in p["url"] or "youtu.be" in p["url"]:
        return "YouTube"
    return {"firefox": "Firefox", "zen": "Zen", "chromium": "Chromium", "mpv": "mpv", "anibeam": "anibeam"}.get(base, base)


HELD_PLAYERS = []  # paused by a card the lock closed, played again on unlock


def pause_videos():
    paused = []
    for p in players():
        if p["status"] == "Playing" and not p["music"]:
            run(["playerctl", "-p", p["name"], "pause"])
            paused.append(p)
    return paused


def resume(paused):
    for p in paused:
        run(["playerctl", "-p", p["name"], "play"])


def play_sound(cfg):
    if cfg.get("sound") and Path(SOUND).exists():
        player = shutil.which("pw-play") or shutil.which("paplay")
        if player:
            subprocess.Popen([player, SOUND], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def overlay(args, env=None, stop=None):
    """Run the card in its own process, so GTK never lives inside the daemon.
    When stop() turns true the card is closed and the answer is "stopped"."""
    env = env or hypr_env()
    args = [*args, *shlex.split(os.environ.get("PUSHUP_OVERLAY_ARGS", ""))]
    proc = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "overlay", *args],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env)
    while True:
        try:
            out, err = proc.communicate(timeout=2 if stop else None)
            break
        except subprocess.TimeoutExpired:
            if stop():
                proc.terminate()
                try:
                    proc.communicate(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.communicate()
                return "stopped"
    lines = out.strip().splitlines()
    if proc.returncode != 0 and err:
        print(err.strip(), file=sys.stderr)
    return lines[-1] if lines else ""


def run_intro(env=None, page=1):
    cfg = load_config()
    current = next((name for name, rng in LEVELS.items() if rng == (cfg["reps_min"], cfg["reps_max"])), "custom")
    # Someone who never picked gets everything ticked that needs no gear. Someone who picked from the first batch keeps
    # those picks, and the second batch comes ticked so it gets a look.
    if SEEN_EXERCISES.exists():
        picked = cfg["exercises"]
    elif SEEN_FIRST_MOVES.exists():
        picked = [e for e in EXERCISES if e in cfg["exercises"] or e in SECOND_BATCH]
    else:
        picked = list(catalog.DEFAULT_EXERCISES)
    goals = sorted({STRETCHES[s]["goal"] for s in cfg["stretches"]})
    choice = overlay(["--intro", "--spice", cfg["spice"], "--level", current, "--page", str(page),
                      "--picked", ",".join(picked), "--goals", ",".join(goals), "--gear", ",".join(cfg["gear"])], env)
    try:
        answer = json.loads(choice)
    except ValueError:
        answer = {}
    if answer.get("level") in LEVELS:
        cfg["reps_min"], cfg["reps_max"] = LEVELS[answer["level"]]
    if answer.get("spice") in SPICES:
        cfg["spice"] = answer["spice"]
    chosen = [e for e in answer.get("exercises", []) if e in EXERCISES]
    if chosen:
        cfg["exercises"] = chosen
    if isinstance(answer.get("gear"), list):
        cfg["gear"] = [t for t in catalog.TOOLS if t in answer["gear"]]
    chosen_goals = [g for g in answer.get("goals", []) if g in catalog.GOALS]
    if chosen_goals and set(chosen_goals) != set(goals):
        # Only the goals that changed move: a stretch turned off by hand stays off.
        cfg["stretches"] = [s for s, v in STRETCHES.items() if v["goal"] in chosen_goals and s in catalog.MIXED_STRETCHES
                            and (s in cfg["stretches"] or v["goal"] not in goals)]
    save_config(cfg)
    stamp = dt.datetime.now().isoformat(timespec="seconds") + f" {choice or 'closed'}\n"
    write_text(ONBOARDED, stamp)
    if answer:
        # A crashed intro shouldn't count as having seen the exercise pages.
        write_text(SEEN_EXERCISES, stamp)
    return f"{cfg['reps_min']} to {cfg['reps_max']} reps, {cfg['spice']}, {len(available(cfg))} exercises"


def sets_of(entries, exercise):
    return [e for e in entries if did(e) > 0 and exercise_of(e) == exercise]


def load_at(t, sets):
    """Recent reps, each one fading by half every FATIGUE_HALF_LIFE. A night's sleep clears it."""
    return sum(did(e) * 0.5 ** ((t - e["ts"]) / FATIGUE_HALF_LIFE) for e in sets if t - 86400 < e["ts"] < t)


def form(entries, exercise="push-ups", now=None):
    """What you can do fresh, and how much of it is left right now.

    Recent reps are fatigue, measured in sets' worth of your fresh number, and each set's worth
    takes a share off: `rate`, which starts at FATIGUE_START and is learned from how far your
    sets drop as a session goes on. Sets that don't drop teach it that you don't tire. `fresh`
    is learned from every set with its fatigue taken back out, moving a third of the way each
    time, so a tired 8 at 3 a.m. counts as the fresh 11 it stands for instead of as lost
    strength. It never goes past your best recent set. None until there is something logged."""
    sets = sets_of(entries, exercise)
    if not sets:
        return None
    window = sets[-30:]
    best = max(did(e) for e in window)
    fresh, rate = best, FATIGUE_START
    for i in range(len(sets) - len(window), len(sets)):
        reps = did(sets[i])
        load = load_at(sets[i]["ts"], sets[max(0, i - 50):i]) / fresh
        if load >= 0.5:
            seen = min(0.25, max(0.0, math.log(fresh / reps) / load))
            rate += 0.2 * (seen - rate)
        fresh = min(best, fresh + 0.35 * (reps / math.exp(-rate * load) - fresh))
    now = time.time() if now is None else now
    session = [sets[-1]]
    for e in reversed(sets[:-1]):
        if session[0]["ts"] - e["ts"] > SESSION_GAP:
            break
        session.insert(0, e)
    return {"fresh": fresh, "left": math.exp(-rate * load_at(now, sets[-50:]) / fresh),
            "last": sets[-1], "session": session, "now": now}


def plan(cfg, entries, exercise="push-ups", now=None):
    """The goals the next card can ask for, and a line on why when it asks for less than usual.

    Before any logs, that's your level. Fresh, it's what you can do plus one or two. Tired, it's
    what you can still do, or one more. Right after a set you came up short on, it's no more than
    that set: you won't do more an hour later on the same arms."""
    f = form(entries, exercise, now)
    scale = catalog.info(exercise)["scale"]
    if f is None:
        return round(cfg["reps_min"] * scale), round(cfg["reps_max"] * scale), ""
    expect = round(f["fresh"] * f["left"])
    tired = f["left"] < 0.95
    step = max(1, round(scale))  # one more push-up is three more seconds of plank
    lo, hi = (max(3, min(round(80 * scale), n)) for n in ((expect, expect + step) if tired else (expect + step, expect + 2 * step)))
    why = ""
    if tired:
        reps = sum(did(e) for e in f["session"])
        why = f"Tired: {reps} reps since {fmt_clock(f['session'][0]['ts'])}, about {round((1 - f['left']) * 100)}% down"
    last = f["last"]
    if f["now"] - last["ts"] < SESSION_GAP and did(last) < last.get("reps", 0) and did(last) < hi:
        hi = did(last)
        lo = min(lo, hi)
        why = why or f"You came up short with {hi} last set, so no more than that"
    return lo, hi, why


# Saying a part hurts. Goals for moves that lean on it come down, and so does the day's target in
# the challenge, by how much that part has been worked lately: a sore chest after three days of
# push-ups gets a big cut, one that has had an easy week only a small one. Each day in a row it gets
# less: the third day it's only a little less, and from the fourth the card stops cutting further
# and says it's time to rest it or have it looked at. A report counts for its day and, at half
# strength, the day after.
HURT_DAYS = 3  # the work that could explain it: the last three days in full, the two before at half
HURT_KEEP = (0.4, 0.8)  # the share of the usual goal kept: worked hard, and hardly worked


def part_work(entries, part, t):
    """Reps that leaned on a part in the days before t, in push-ups' worth, and a normal day's."""
    def worth(e):
        x = catalog.info(exercise_of(e))
        return did(e) / x["scale"] * x["parts"].get(part, 0) if not x.get("timed") else did(e) / 3 * x["parts"].get(part, 0)
    recent, days = 0.0, {}
    for e in entries:
        age = t - e["ts"]
        if e.get("result") == "session" or did(e) <= 0 or not 0 <= age < 14 * 86400:
            continue
        w = worth(e)
        recent += w if age < HURT_DAYS * 86400 else w / 2 if age < (HURT_DAYS + 2) * 86400 else 0
        days[day_of(e["ts"])] = days.get(day_of(e["ts"]), 0) + w
    normal = max(30, sum(days.values()) / len(days) if days else 0)
    # Training elsewhere counts too: a session's load is about a normal day of reps on what it works.
    for e in catalog.sessions(entries):
        age = t - e["ts"]
        w = catalog.session_load(e) * catalog.ACTIVITIES[e["activity"]]["parts"].get(part, 0) * normal
        recent += w if 0 <= age < HURT_DAYS * 86400 else w / 2 if 0 <= age < (HURT_DAYS + 2) * 86400 else 0
    return recent, normal


def hurt_on(entries, part, day):
    """How a part that hurts stands on a day: None, or the share of the usual goal to keep, the days
    in a row it has hurt, whether it was said that day or the one before, and the reps behind it."""
    if part not in HURT_PARTS:
        return None
    said = [e for e in entries if e.get("part") == part and e.get("result") in ("hurt", "healed") and day_of(e["ts"]) <= day]
    # What hurts now: the spots said on the last day a report came, added up, less any said to be
    # better since. A report with no spots is the whole part; a healed one with none clears it.
    whole, spots, on = False, [], None
    for e in said:
        mine = [list(s) for s in catalog.spots_by_part(e.get("spots") or []).get(part, [])]
        if e["result"] == "hurt":
            if on != day_of(e["ts"]):
                whole, spots, on = False, [], day_of(e["ts"])
            whole = whole or not mine
            spots += [s for s in mine if s not in spots]
        elif mine and not whole:
            spots = [s for s in spots if s not in mine]
            if not spots:
                on = None
        else:
            whole, spots, on = False, [], None
    if on is None:
        return None
    last = [e for e in said if e["result"] == "hurt"][-1]
    age = (day - day_of(last["ts"])).days
    if age > 1:
        return None
    hurt_days = {day_of(e["ts"]) for e in said if e["result"] == "hurt"}
    streak, d = 0, day_of(last["ts"])
    while d in hurt_days:
        streak, d = streak + 1, d - dt.timedelta(days=1)
    recent, normal = part_work(entries, part, last["ts"])
    # Three normal days in the last few is plenty to explain it, half again more is a lot.
    ratio = min(1.5, recent / (HURT_DAYS * normal)) / 1.5
    hard, easy = HURT_KEEP
    keep = easy - (easy - hard) * ratio
    if streak >= 3:
        keep = 1 - (1 - keep) / 2
    if streak >= 4:
        keep = max(keep, 0.8)
    if age == 1:
        keep = 1 - (1 - keep) / 2
    spots = [] if whole else spots
    return {"part": part, "keep": keep, "streak": streak, "yesterday": age == 1, "reps": round(recent),
            "spots": spots, "name": catalog.spots_text(spots) or catalog.PART_NAMES[part],
            "worked": ratio >= 0.5}


HURT_PARTS = catalog.HURT_PARTS
hurt_part = catalog.hurt_part
_hurt_memo = {}


def hurting(entries, now=None):
    """Every part that hurts today, by part. One log read gives the same answer every time it's asked."""
    day = day_of(time.time() if now is None else now)
    key = (id(entries), len(entries), day)
    if key not in _hurt_memo:
        _hurt_memo.clear()
        _hurt_memo[key] = {p: h for p in HURT_PARTS if (h := hurt_on(entries, p, day))}
    return _hurt_memo[key]


def eased(n, keep):
    return n if keep >= 1 else max(2, round(n * keep))


def hurt_weight(exercise, h):
    """How hard a move leans on what hurts: on the muscles you picked, or on the whole part when
    you only named the part. Sore triceps weigh on push-ups (0.8), not on squats."""
    e = catalog.info(exercise)
    if e.get("stretch"):
        return 0  # a stretch's muscles are what it loosens, not what it loads
    if h.get("spots"):
        return max((e.get("muscles", {}).get(m, 0) for m, _ in h["spots"]), default=0)
    return e["parts"].get(h["part"], 0)


def hurt_trim(exercise, hurts):
    """How much of the usual goal an exercise keeps for what hurts, and the worst of it. A move
    that only brushes a sore muscle keeps more than one that leans on it."""
    best = (1.0, None)
    for p, h in hurts.items():
        w = hurt_weight(exercise, h)
        if w >= 0.3:
            keep = 1 - (1 - h["keep"]) * w
            best = min(best, (keep, h), key=lambda kv: kv[0])
    return best


def hurt_why(h, goal, usual):
    name = h["name"]
    if h["streak"] >= 4:
        return (f"{h['streak']} days in a row your {name} hurt. That's not training soreness any more: "
                f"rest them (pushup pause tomorrow) or get them looked at. {goal} instead of {usual}")
    if h["yesterday"]:
        return f"Your {name} hurt yesterday, so still a bit less: {goal} instead of {usual}"
    if h["streak"] == 3:
        return f"Third day your {name} hurt, so only a little less: {goal} instead of {usual}"
    if h["worked"]:
        return f"Your {name} hurt, and they earned it: {h['reps']} reps these last few days. {goal} instead of {usual}"
    return f"Your {name} hurt, though they've had an easy few days. A bit less: {goal} instead of {usual}"


def log_hurt(part, healed=False, spots=None):
    """What hurts, kept: the part, and the muscles and sides when you picked them."""
    log_event(result="healed" if healed else "hurt", part=part, **({"spots": spots} if spots else {}))


def goal_range(cfg, entries, exercise, load, now=None):
    """The goals a card for this exercise can ask, with the trim for a part still recovering: what
    to show or log when nobody rolls the dice."""
    lo, hi, _ = plan(cfg, entries, exercise, now)
    factor = catalog.recovery_factor(exercise, load)
    if factor < 0.9:
        lo, hi = (max(3, round(n * factor)) for n in (lo, hi))
    keep, _ = hurt_trim(exercise, hurting(entries, now))
    return eased(lo, keep), eased(hi, keep)


def option(cfg, entries, exercise, load, now=None):
    """One exercise the card can offer: its goal, the slider's end, and why the goal is low."""
    lo, hi, why = plan(cfg, entries, exercise, now)
    factor = catalog.recovery_factor(exercise, load)
    goal = usual = random.randint(lo, hi)
    if factor < 0.9:
        # A small dent isn't worth a sentence; a real one is.
        goal = max(3, round(usual * factor))
        parts = catalog.info(exercise)["parts"]
        part = max(parts, key=lambda p: parts[p] * load[p])
        if goal < usual:
            why = why or f"Your {catalog.PART_NAMES[part]} {catalog.verb(part)} still recovering, so {goal} instead of {usual}"
    keep, h = hurt_trim(exercise, hurting(entries, now))
    if h:
        less = eased(goal, keep)
        why = hurt_why(h, less, goal) if less < goal else why
        goal = less
    top = max(slider_top(round(cfg["reps_max"] * catalog.info(exercise)["scale"])), slider_top(goal))
    return {"exercise": exercise, "goal": goal, "top": top, "why": why, **({"easy": h["part"]} if h else {})}


def available(cfg):
    """The exercises switched on that the gear you have allows. Push-ups when none are."""
    return [e for e in cfg["exercises"] if catalog.can_do(e, cfg["gear"])] or ["push-ups"]


def options(cfg, entries, now=None, week=None):
    """What the card offers, first pick first. Sore body parts are left out, the exercise you just did
    goes to the back, and the rest is shuffled with a lean toward what you did least lately."""
    now = time.time() if now is None else now
    load = catalog.loads(entries, now)
    usable = available(cfg)
    hurts = hurting(entries, now)
    pool = [e for e in usable if not catalog.sore(e, load)
            and not any(hurt_weight(e, h) >= 0.7 for h in hurts.values())]
    if not pool:
        pool = [max(usable, key=lambda e: catalog.recovery_factor(e, load))]
    return [option(cfg, entries, e, load, now) for e in shuffle(pool, entries, now, week=week)]


def shuffle(pool, entries, now, stretch=False, week=None):
    """A pool in the order to offer it: what you did lately goes back, the one you just did
    furthest, and moves for muscles that got little this week come forward. Stretches and
    exercises each only look at their own kind."""
    recent = [exercise_of(e) for e in entries if did(e) > 0 and now - e["ts"] < (24 if stretch else 6) * 3600
              and catalog.is_stretch(exercise_of(e)) == stretch]
    last = recent[-1] if recent else None
    work, stretched = (week or catalog.muscle_week(entries, now))[:2]
    week = stretched if stretch else work
    weights = {e: catalog.balance_weight(e, week) / (1 + recent.count(e)) * (0.15 if e == last and len(pool) > 1 else 1)
               for e in pool}
    order = []
    while weights:
        pick = random.choices(list(weights), weights=list(weights.values()))[0]
        order.append(pick)
        del weights[pick]
    return order


def stretch_options(cfg, entries, now=None, rest=None, week=None):
    """The stretches a card can offer. A hold grows five seconds for every four you've done of it,
    up to twice where it started."""
    now = time.time() if now is None else now
    out = []
    for name in shuffle(cfg["stretches"], entries, now, stretch=True, week=week):
        s = STRETCHES[name]
        if s.get("hard"):
            # David's sets don't grow longer: 30 s is the sweet spot, and the progress is depth.
            sets = s.get("sets", 1)
            out.append({"exercise": name, "goal": s["hold"], "top": slider_top(round(s["hold"] * 1.5)), "stretch": True,
                        "why": f"David's {catalog.GOALS[s['goal']]} work. {s['cue']}",
                        "progress": f"{sets} sets of {s['hold']} s. A little deeper than last time, never into pain."})
            continue
        done = sum(1 for e in sets_of(entries, name) if did(e) >= s["hold"] * 0.8)
        goal = min(2 * s["hold"], s["hold"] + 5 * (done // 4))
        why = f"Rest day after {rest}: stretches only" if rest else f"For the {catalog.GOALS[s['goal']]}"
        if goal >= 2 * s["hold"]:
            progress = f"{goal} s is as long as this hold gets. Keep it there."
        else:
            more = 4 - done % 4
            progress = f"{more} more hold{'s' if more != 1 else ''} like this and it grows to {min(goal + 5, 2 * s['hold'])} s."
        out.append({"exercise": name, "goal": goal, "top": slider_top(round(goal * 1.5)), "why": why, "stretch": True,
                    "progress": progress})
    return out


def stretching_on(cfg):
    return bool(cfg.get("stretching", True))


def rest_card(cfg, entries, now, forced=False):
    """What a rest day does to the next card: (why, no_card). With stretches on it's a calm stretch
    card. With them off there's no card, unless you asked for one, which is then a plain card. The
    challenge has no rest days."""
    rest = None if challenge_on(cfg) else catalog.resting(entries, now)
    if not rest:
        return None, False
    if stretching_on(cfg):
        return rest[1], False
    return None, not forced


def stretch_due(cfg, entries):
    """Every stretch_every-th card is a stretch: true once that many cards in a row weren't."""
    every = int(cfg.get("stretch_every") or 0)
    if every < 2 or not stretching_on(cfg):
        return False
    # Cards, plus stretches logged by hand: stretching on your own counts as the stretch.
    cards = [e for e in entries if (e.get("result") in ("done", "skip", "pass") and e.get("reps"))
             or (e.get("result") == "manual" and catalog.is_stretch(exercise_of(e)))]
    run = 0
    for e in reversed(cards):
        if catalog.is_stretch(exercise_of(e)):
            break
        run += 1
    return run >= every - 1


def challenge_on(cfg):
    return cfg.get("mode") == "challenge" and bool(cfg.get("challenge_start"))


def trained_on(day, entries):
    """The sessions that make a day a training day, described: 'bouldering 1h'."""
    return [catalog.describe(e) for e in catalog.sessions(entries) if day_of(e["ts"]) == day and catalog.training_day(e)]


def eased_target(target, h):
    """The day's push-up target, cut for chest and arms that hurt that day (h, from hurt_on).
    Nothing to cut: as is."""
    keep = hurt_trim("push-ups", {"push": h})[0] if h else 1
    return target if keep >= 1 else min(target, max(10, 5 * round(target * keep / 5)))


def push_ups_on(day, entries):
    return sum(did(e) for e in entries if exercise_of(e) in PUSH_UPS and did(e) > 0 and day_of(e["ts"]) == day)


def target_for(cfg, n, best):
    """Day n's push-ups: target_start on day one, climbing in steps of five to target by RAMP_DAYS,
    and never more than 25 past your best day so far, so a bad day doesn't snowball."""
    lo, hi = int(cfg["target_start"]), int(cfg["target"])
    ramp = lo + (hi - lo) * min(1, max(0, n - 1) / (RAMP_DAYS - 1))
    return int(min(5 * round(ramp / 5), max(lo, 5 * round((best + 25) / 5))))


def bss_plan(cfg, entries, n, day):
    """Bulgarians, taken easy: two sets a day the first week, three the second, four after. A set
    starts at 5 each leg and grows by one each leg for every earlier day you hit the goal, up to 15."""
    start = dt.date.fromisoformat(cfg["challenge_start"])
    sets = [e for e in entries if exercise_of(e) == BSS and e.get("result") in ("done", "manual", "skip")]
    # Only a card's set has a goal to hit; one logged by hand says nothing about it.
    good = {day_of(e["ts"]) for e in sets if e.get("result") == "done" and e.get("reps")
            and did(e) >= e["reps"] and start <= day_of(e["ts"]) < day}
    today_sets = [e for e in sets if day_of(e["ts"]) == day and did(e) > 0]
    cap = 2 if n <= 7 else 3 if n <= 14 else 4
    return {"goal": min(15, 5 + len(good)), "sets": len(today_sets), "cap": cap,
            "each_leg": sum(did(e) for e in today_sets)}


def rows_plan(cfg, entries, n, day, now):
    """Body rows at the table edge, the pull the push-ups were missing: three sets a day, four from
    the third week. The goal is learned from your sets like any other move's; `goal` is the top of
    what the next card can ask, recovery trim included, for logging one from the launcher."""
    today_sets = [e for e in entries if exercise_of(e) == ROWS and did(e) > 0 and day_of(e["ts"]) == day]
    cap = (3 if n <= 14 else 4) if cfg.get("rows", True) else 0
    return {"goal": goal_range(cfg, entries, ROWS, catalog.loads(entries, now), now)[1], "sets": len(today_sets),
            "cap": cap, "reps": sum(did(e) for e in today_sets)}


def challenge(cfg, entries, now=None):
    """Where the challenge stands: which day, the push-ups against the target, the days so far."""
    now = time.time() if now is None else now
    day = day_of(now)
    start = dt.date.fromisoformat(cfg["challenge_start"])
    n = (day - start).days + 1
    past, best = [], 0
    for i in range(max(0, n - 1)):
        d = start + dt.timedelta(days=i)
        got = push_ups_on(d, entries)
        past.append({"day": i + 1, "done": got, "target": eased_target(target_for(cfg, i + 1, best), hurt_on(entries, "push", d)),
                     "trained": bool(trained_on(d, entries))})
        best = max(best, got)
    usual = target_for(cfg, n, best)
    sore = hurt_on(entries, "push", day)
    target = eased_target(usual, sore)
    done = push_ups_on(day, entries)
    trained = trained_on(day, entries)
    return {"day": n, "days": int(cfg["challenge_days"]), "start": cfg["challenge_start"], "done": done,
            "target": target, "usual_target": usual,
            "eased_by": sore["name"] if sore and target < usual else "", "left": max(0, target - done), "best": best, "deadline": day_end_ts(day),
            "history": past + [{"day": n, "done": done, "target": target, "trained": bool(trained)}],
            "trained": trained, "feet_up": bool(cfg["feet_up"]),
            "bss": bss_plan(cfg, entries, n, day), "rows": rows_plan(cfg, entries, n, day, now),
            "stretching": stretching_on(cfg), "started": day_of(read_float(DAY_START)) == day,
            "ramp": [target_for(cfg, i, 10 ** 6) for i in range(1, int(cfg["challenge_days"]) + 1)]}


def side_due(cfg, entries, now, moves):
    """Which of the moves besides push-ups this card is for, if any. Each comes round every
    <key>_every cards (bss_every, rows_every) until its sets for the day are in, never two of them
    in a row, so push-ups sit between, and when two are due the one that has waited longest goes first."""
    sides = [m for m, _ in SIDES]
    # A passed bonus card counts as its turn too, or a passed Bulgarians card would lead every card after it.
    cards = [e for e in entries if e.get("result") in ("done", "skip", "manual", "pass") and day_of(e["ts"]) == day_of(now)
             and exercise_of(e) in (*PUSH_UPS, *sides)]
    if not cards or exercise_of(cards[-1]) in sides:
        return None  # the first card of the day is push-ups, and so is the one after any other move
    every = {m: max(2, int(cfg.get(f"{k}_every") or 3)) for m, k in SIDES}
    waits = {}
    for move in moves:
        since = next((i for i, e in enumerate(reversed(cards)) if exercise_of(e) == move), None)
        waits[move] = len(cards) + every[move] if since is None else since  # none yet today: due now
    due = [m for m in moves if waits[m] >= every[m] - 1]
    return max(due, key=lambda m: waits[m]) if due else None


def challenge_offer(cfg, entries, now=None):
    """The card in the challenge: push-ups, feet up first once you've switched them on, and on their
    turn a set of Bulgarians, each leg, or of rows at the table edge. Tab swaps between them."""
    now = time.time() if now is None else now
    c = challenge(cfg, entries, now)
    load = catalog.loads(entries, now)
    pushes = [option(cfg, entries, e, load, now) for e in (("decline push-ups", "push-ups") if c["feet_up"] else ("push-ups",))]
    sides = []
    b = c["bss"]
    if b["sets"] < b["cap"] and not catalog.sore(BSS, load):
        lo, hi, why = plan(cfg, entries, BSS, now)
        goal = min(b["goal"], max(3, hi)) if form(entries, BSS, now) else b["goal"]
        why = why if goal < b["goal"] else ""
        keep, h = hurt_trim(BSS, hurting(entries, now))
        if h and eased(goal, keep) < goal:
            why, goal = hurt_why(h, eased(goal, keep), goal), eased(goal, keep)
        sides.append({"exercise": BSS, "goal": goal, "top": slider_top(max(goal, 15)), "why": why,
                      "progress": f"Set {b['sets'] + 1} of {b['cap']} today", **({"easy": h["part"]} if h else {})})
    r = c["rows"]
    if r["sets"] < r["cap"] and not catalog.sore(ROWS, load):
        sides.append(option(cfg, entries, ROWS, load, now))  # the card writes its "set 1 of 3" line
    due = side_due(cfg, entries, now, [o["exercise"] for o in sides])
    return [*(o for o in sides if o["exercise"] == due), *pushes, *(o for o in sides if o["exercise"] != due)], c


def challenge_stretches(cfg):
    """The stretches the challenge asks for: the hard ones, never the easy warm-ups."""
    return [n for n, v in STRETCHES.items() if v.get("hard")]


def challenge_stretch_due(cfg, entries, c):
    """Stretches wait until the day's push-ups are in: before that, every card is a push-up card."""
    every = int(cfg.get("challenge_stretch_every") or 0)
    return (c["left"] <= 0 and every >= 2 and stretching_on(cfg) and bool(challenge_stretches(cfg))
            and stretch_due({**cfg, "stretch_every": every}, entries))


def bonus_passes(entries, now):
    """Bonus cards passed in a row today: past the target a pass is free, but each one says not now."""
    n = 0
    for e in reversed(entries):
        if day_of(e["ts"]) != day_of(now):
            break
        if e.get("result") == "pass":
            n += 1
        elif e.get("result") in ("done", "skip", "manual"):
            break
    return n


def challenge_args(c):
    """What the card shows of the challenge."""
    return ["--challenge", json.dumps({k: c[k] for k in ("day", "days", "done", "target", "deadline", "bss", "rows",
                                                         "history", "ramp", "feet_up", "left", "stretching", "trained")})]


def challenge_interval(cfg, entries=None, now=None):
    """How long until the next set: what's left of the target, spread over what's left of the day
    up to SLACK before day_ends, with a set at least every GAP_MAX and never closer than GAP_MIN.
    A set is counted at the low end of its goal, so the plan doesn't lean on good sets. Past the
    target every card is a bonus, every 40 to 55 minutes, and 20 more for each one passed in a row,
    up to 40: it still asks, it just stops pressing. Inside the slack and still short, it's
    GAP_MIN: you're still up, so it keeps pushing."""
    entries = read_log() if entries is None else entries
    now = time.time() if now is None else now
    c = challenge(cfg, entries, now)
    if c["left"] <= 0:
        return random.uniform(*BONUS_GAP) + BONUS_BACKOFF * min(BONUS_BACKOFF_MAX, bonus_passes(entries, now))
    first = "decline push-ups" if c["feet_up"] else "push-ups"
    lo, hi, _ = plan(cfg, entries, first, now)
    keep, _ = hurt_trim(first, hurting(entries, now))
    per_set = eased(lo, keep) if keep < 1 else max(3, lo)
    load = catalog.loads(entries, now)
    # Only what a card will offer takes a slot: a move left out while its muscles recover doesn't.
    slots = math.ceil(c["left"] / per_set) + sum(max(0, c[k]["cap"] - c[k]["sets"]) for m, k in SIDES
                                                 if not catalog.sore(m, load))
    gap = (c["deadline"] - SLACK - now) / (slots + 0.5)
    return min(GAP_MAX, max(GAP_MIN, gap)) * random.uniform(0.9, 1.1)


def day_begins(cfg, now, mark=True):
    """Has today's challenge day started? Once DAY_ROLL has passed, it starts the first time you're
    back after a night away: the screen locked or the computer off for AWAY, or at WAKE_FALLBACK if
    you never left. A night that ended before DAY_ROLL counts too (WOKE). Marks the start unless
    mark is False, and returns True."""
    started = read_float(DAY_START)
    if day_of(started) == day_of(now):
        return True
    slept = read_float(WOKE) > day_end_ts(day_of(started))
    fresh = (not DAY_START.exists() or slept or now - read_float(LAST_ACTIVE) >= AWAY
             or dt.datetime.fromtimestamp(now).hour >= WAKE_FALLBACK)
    if fresh and mark:
        write_text(DAY_START, str(now))
    return fresh


def challenge_quiet(cfg, now, entries=None, mark=False):
    """No cards: the day hasn't started yet, you trained today (climbing, a run: the day's work is
    done, so the push-ups take it off), or it's past day_ends with the target done."""
    if not day_begins(cfg, now, mark):
        return True
    c = challenge(cfg, read_log() if entries is None else entries, now)
    return bool(c["trained"]) or (now > day_end_ts(day_of(now)) and c["left"] <= 0)


def parse_answer(text):
    try:
        answer = json.loads(text)
        return answer if isinstance(answer, dict) else {}
    except ValueError:
        return {"result": text.strip()}


def log_answer(answer, offered=None):
    """Record what a card said happened. Returns a short line for the daemon log."""
    result = answer.get("result")
    if result == "done" and answer.get("did", 0) >= 0 and isinstance(answer.get("exercise"), str):
        log_event(reps=answer.get("goal", 0), did=answer["did"], exercise=answer["exercise"], result="done")
        return f"done {answer['did']} {answer['exercise']}"
    if result == "manual" and answer.get("did", 0) > 0 and isinstance(answer.get("exercise"), str):
        sets = max(1, min(10, int(answer.get("sets", 1))))
        log_sets(answer["exercise"], answer["did"], sets, source="card")
        return f"logged {sets}x{answer['did']} {answer['exercise']}"
    if result == "session" and answer.get("activity") in ACTIVITIES and answer.get("minutes", 0) > 0:
        log_session(answer["activity"], answer["minutes"], answer.get("effort", "normal"), answer.get("days_ago", 0))
        return f"trained {answer['activity']} {answer['minutes']} min"
    if result in ("skip", "pass") and offered:
        # A pass is a skip on a rest day card or a bonus card past the target: written down, never held against you.
        log_event(reps=offered["goal"], did=0, exercise=answer.get("exercise", offered["exercise"]), result=result)
        return result
    return ""


def log_session(activity, minutes, effort="normal", days_ago=0, source="manual"):
    ts = time.time()
    if days_ago:
        # Yesterday's session counts from the evening, which is when most of them happen.
        day = today() - dt.timedelta(days=days_ago)
        ts = dt.datetime.combine(day, dt.time(18)).timestamp()
    log_event(ts=ts, result="session", activity=activity, minutes=int(minutes), effort=effort, source=source)


def remind(cfg, env=None, rest=None, held=None):
    """One card. rest is why it's a rest day, which makes it a calm stretch card. held is what an
    earlier card for this same set already paused: "it hurts" brings the card straight back, eased."""
    entries = read_log()
    now = time.time()
    week = catalog.muscle_week(entries, now)
    extra, bonus = [], False
    if challenge_on(cfg):
        offer, c = challenge_offer(cfg, entries, now)
        extra = challenge_args(c)
        bonus = c["left"] <= 0  # the day's push-ups are in: this card is extra, the card says so too
        if challenge_stretch_due(cfg, entries, c):
            offer = stretch_options({**cfg, "stretches": challenge_stretches(cfg)}, entries, now, week=week)
    else:
        stretch = bool(rest) or stretch_due(cfg, entries)
        offer = stretch_options(cfg, entries, now, rest, week) if stretch else options(cfg, entries, now, week)
    first = offer[0]
    paused = [*(held or []), *pause_videos()]
    if held is None:
        play_sound(cfg)
    if extra and not SEEN_CHALLENGE.exists():
        # The first card of the challenge comes after a page on what the challenge is.
        if overlay(["--challenge-intro", "--spice", cfg["spice"], *extra], env, stop=session_locked) == "stopped":
            HELD_PLAYERS.extend(paused)
            return "locked"
        write_text(SEEN_CHALLENGE, dt.datetime.now().isoformat(timespec="seconds") + "\n")
    args = ["--options", json.dumps(offer), *extra,
            "--spice", cfg["spice"], *record_args(entries, week=week)]
    if rest:
        args += ["--calm"]
    if not cfg.get("sound"):
        args += ["--quiet"]
    if paused:
        args += ["--paused", ", ".join(dict.fromkeys(pretty_player(p) for p in paused))]
    text = overlay(args, env, stop=session_locked)
    if text == "stopped":
        # Locked while the card was up: nobody is there to do it or skip it, and nobody to watch the video.
        HELD_PLAYERS.extend(paused)
        return "locked"
    answer = parse_answer(text)
    if answer.get("result") == "trained":
        # "Already trained": the logging card takes over, and whatever it logs ends this set.
        text = overlay(["--add", "--from-card", "--recent", json.dumps(recent_sets(entries)),
                        *record_args(entries, week=week, with_stats=False)], env, stop=session_locked)
        if text == "stopped":
            HELD_PLAYERS.extend(paused)
            return "locked"
        logged = log_answer(parse_answer(text))
        resume(paused)
        return logged or "lost"
    if answer.get("result") == "hurt" and isinstance(answer.get("exercise"), str):
        # The muscles picked on the map, each under its part; none picked, the move's main part.
        # The card comes back with them eased.
        spots = catalog.spots_by_part(answer.get("spots") or [])
        for part, where in spots.items():
            log_hurt(part, spots=where)
        part = answer.get("part") if answer.get("part") in HURT_PARTS else hurt_part(answer["exercise"])
        if not spots and part:
            log_hurt(part)
        return remind(cfg, env, rest, held=paused)
    offered = next((o for o in offer if o["exercise"] == answer.get("exercise")), first)
    if offered.get("easy") and (answer.get("result") == "skip" or (answer.get("result") == "done" and answer.get("did") == 0)):
        answer["result"] = "pass"  # a move on a part that hurts: letting it go is fine
    if (rest or bonus) and (answer.get("result") == "skip" or (answer.get("result") == "done" and answer.get("did") == 0)):
        answer["result"] = "pass"  # a rest day card, or a bonus one past the target, never feeds the grudge
    if answer.get("result") == "done":
        answer["goal"] = offered["goal"]
    logged = log_answer(answer, offered)
    if logged and answer.get("receipts"):
        # Asked for the full stats from the ending: they open once the set is in them.
        if after_receipts(receipts(env, stop=session_locked), env, stop=session_locked) == "stopped":
            HELD_PLAYERS.extend(paused)
            return logged
    resume(paused)
    if logged:
        return logged
    # The card crashed, was killed or timed out: nothing was decided, so it doesn't feed the grudge.
    log_event(reps=first["goal"], did=0, exercise=first["exercise"], result="lost")
    return "lost"


slider_top = catalog.slider_top


def next_interval(cfg):
    if challenge_on(cfg):
        return challenge_interval(cfg)
    return random.uniform(cfg["interval_min"], cfg["interval_max"]) * 60


def cmd_daemon(_):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    cfg = load_config()
    if not ONBOARDED.exists():
        run_intro()
        cfg = load_config()
    elif not SEEN_EXERCISES.exists():
        run_intro(page=5)
        cfg = load_config()
    due = read_float(NEXT_DUE)
    if due < time.time() or due - time.time() > cfg["interval_max"] * 60:
        due = time.time() + next_interval(cfg)
        write_text(NEXT_DUE, str(due))
    print(f"pushup: next set at {fmt_clock(due)}", flush=True)
    last_tick = time.time()
    was_locked = False
    quiet, quiet_at = False, 0.0
    exported = 0.0
    while True:
        time.sleep(5)
        now = time.time()
        if now - exported >= OVERVIEW_EVERY:
            # Logging writes it too; this keeps "today" right across midnight and picks up the inbox.
            refresh_overview()
            exported = now
        locked = session_locked()
        if now - last_tick > 600:
            due = now + next_interval(cfg)
            write_text(NEXT_DUE, str(due))
            print(f"pushup: woke from a {fmt_left(now - last_tick)} sleep, next set at {fmt_clock(due)}", flush=True)
        elif locked:
            # The countdown stands still behind the lock screen.
            due += now - last_tick
            if not was_locked:
                due = min(max(due, now) + LOCK_CREDIT, now + cfg["interval_max"] * 60)
                WAITING.unlink(missing_ok=True)
                print(f"pushup: locked, holding {fmt_left(due - now)} until after the unlock", flush=True)
            write_text(NEXT_DUE, str(due))
        elif was_locked:
            resume(HELD_PLAYERS)
            HELD_PLAYERS.clear()
            print(f"pushup: unlocked, next set at {fmt_clock(due)}", flush=True)
        was_locked = locked
        last_tick = now
        cfg = load_config()  # `pushup challenge` changes it while this runs
        written = read_float(NEXT_DUE)
        if written and abs(written - due) > 1:
            due = written  # moved from outside, by `pushup challenge start`
        if challenge_on(cfg) and not locked:
            # The day starts when you're back after a night; past day_ends it goes quiet once the target is done.
            if now - read_float(LAST_ACTIVE) >= AWAY:
                write_text(WOKE, str(now))
            if day_of(read_float(DAY_START)) != day_of(now) and day_begins(cfg, now):
                due = now + FIRST_SET
                write_text(NEXT_DUE, str(due))
                c = challenge(cfg, read_log(), now)
                print(f"pushup: day {c['day']} begins, {c['target']} push-ups by {fmt_clock(c['deadline'])}, "
                      f"first set at {fmt_clock(due)}", flush=True)
            if now - quiet_at >= 60:
                # Reading the whole log every 5 s for this is too much; once a minute is plenty.
                quiet, quiet_at = challenge_quiet(cfg, now), now
            if now - read_float(LAST_ACTIVE) >= 60:
                write_text(LAST_ACTIVE, str(now))
        else:
            quiet, quiet_at = False, 0.0
        forced = TRIGGER.exists()
        if not forced and (now < due or read_float(PAUSED_UNTIL) > now or quiet):
            continue
        TRIGGER.unlink(missing_ok=True)
        if not forced:
            blocker = discord_call() and "a Discord call"
            if blocker:
                if not WAITING.exists():
                    print(f"pushup: due, holding off for {blocker}", flush=True)
                write_text(WAITING, blocker)
                continue
        WAITING.unlink(missing_ok=True)
        rest, no_card = rest_card(cfg, read_log(), now, forced)
        if no_card:
            # A rest day's cards are stretches, and stretches are off: the rest is the whole card.
            due = now + next_interval(cfg)
            write_text(NEXT_DUE, str(due))
            print(f"pushup: rest day, stretches off, no card until {fmt_clock(due)}", flush=True)
            continue
        if rest:
            print(f"pushup: rest day after {rest}, a stretch instead", flush=True)
        result = remind(cfg, rest=rest)
        last_tick = time.time()
        quiet_at = 0.0
        if result == "locked":
            # Still owed, a few minutes after the unlock.
            due, was_locked = last_tick + min(LOCK_CREDIT, cfg["interval_max"] * 60), True
            write_text(NEXT_DUE, str(due))
            print("pushup: locked with the card up, closed it", flush=True)
            continue
        due = last_tick + next_interval(cfg)
        write_text(NEXT_DUE, str(due))
        print(f"pushup: {result}, next set at {fmt_clock(due)}", flush=True)


def daemon_running():
    return run(["systemctl", "--user", "is-active", "pushup.service"]).strip() == "active"


def cmd_now(_):
    if daemon_running():
        write_text(TRIGGER, "1")
        print("Coming up in a few seconds.")
    else:
        cfg = load_config()
        print(remind(cfg, rest=rest_card(cfg, read_log(), time.time(), forced=True)[0]))


def status_json():
    """Everything the launcher plugin shows, in one read."""
    now = time.time()
    cfg = load_config()
    entries = read_log()
    running = daemon_running()
    due = read_float(NEXT_DUE)
    out = {"running": running, "locked": session_locked(), "paused_until": max(0.0, read_float(PAUSED_UNTIL)),
           "next_due": due if running else 0, "waiting": WAITING.read_text().strip() if WAITING.exists() else "",
           "mode": cfg["mode"], "spice": cfg["spice"], "today": done_on(today(), entries),
           "streak": day_streak(entries), "skips": skip_streak(entries), "challenge": None,
           "hurts": {p: {"keep": round(h["keep"], 2), "streak": h["streak"], "yesterday": h["yesterday"], "spots": h["spots"]}
                     for p, h in hurting(entries, now).items()}}
    last = last_set(entries)
    out["last"] = {"ts": last["ts"], "did": did(last), "exercise": exercise_of(last)} if last else None
    if challenge_on(cfg):
        c = challenge(cfg, entries, now)
        offer, _ = challenge_offer(cfg, entries, now)
        if challenge_stretch_due(cfg, entries, c):
            offer = stretch_options({**cfg, "stretches": challenge_stretches(cfg)}, entries, now)
        first = offer[0]
        # The card picks within a range; the launcher says the range rather than one roll of it.
        fixed = first["exercise"] == BSS or first.get("stretch")
        lo, hi = (first["goal"],) * 2 if fixed else goal_range(cfg, entries, first["exercise"], catalog.loads(entries, now), now)
        out["challenge"] = {**c, "next": [{"exercise": first["exercise"], "goal": first["goal"],
                                           "stretch": bool(first.get("stretch")),
                                           "range": str(lo) if lo == hi else f"{lo} to {hi}"}],
                            "quiet": challenge_quiet(cfg, now, entries)}
    return out


