    return text


def cmd_exercises(args):
    cfg = load_config()
    if args.action:
        # Names with a space may come split in two ("glute bridges"), so join words until one matches.
        names, word = [], ""
        known = {n.lower(): n for n in (*EXERCISES, *STRETCHES)}  # 'l-sit' means L-sit
        for token in args.names:
            word = f"{word} {token}".strip()
            if word.lower() in known:
                names.append(known[word.lower()])
                word = ""
        if word or not names:
            raise SystemExit(f"pushup: pick from {', '.join([*EXERCISES, *STRETCHES])}")
        for key, catalog_names in (("exercises", EXERCISES), ("stretches", STRETCHES)):
            mine = [n for n in names if n in catalog_names]
            if not mine:
                continue
            if args.action == "on":
                cfg[key] = [e for e in catalog_names if e in cfg[key] or e in mine]
                for e in mine:
                    if not catalog.can_do(e, cfg["gear"]):
                        print(f"{e} is on, but needs {catalog.needs(e)} first: pushup gear on {catalog.GEAR[e][0]}")
            else:
                cfg[key] = [e for e in cfg[key] if e not in mine] or [next(iter(catalog_names))]
        save_config(cfg)
    load = catalog.loads(read_log(), time.time())
    for name, e in EXERCISES.items():
        mark = "on " if name in cfg["exercises"] else "off"
        part = catalog.sore(name, load)
        note = f"  resting your {catalog.PART_NAMES[part]}" if part else ""
        if not catalog.can_do(name, cfg["gear"]):
            mark, note = "off", f"  needs {catalog.needs(name)}: pushup gear on {catalog.GEAR[name][0]}"
        print(f"{mark}  {name:<23} {', '.join(e['muscles'])}{note}")
    print()
    for name, e in STRETCHES.items():
        mark = "on " if name in cfg["stretches"] else "off"
        print(f"{mark}  {name:<23} {catalog.GOALS[e['goal']]}: {', '.join(e['muscles'])}")


def cmd_sync(_):
    """Write the overview now and say what is shared and what came in."""
    wrote = refresh_overview()
    local = read_local()
    print(f"overview   {OVERVIEW}, " + ("written now" if wrote else "NOT written, see the error above"))
    print(f"log        {LOG}, {len(local)} entries")
    inbox = read_inbox(local)
    if inbox:
        by = {}
        for e in inbox:
            by.setdefault(e["source"], []).append(e)
        for source, got in sorted(by.items()):
            newest = max(got, key=lambda e: e["ts"])
            print(f"inbox      {source}: {len(got)} {'entry' if len(got) == 1 else 'entries'}, newest "
                  f"{dt.datetime.fromtimestamp(newest['ts']):%a %d %b %H:%M}")
    else:
        print(f"inbox      {INBOX}: nothing in yet")
    print("syncthing  folder pushup goes out to nemurenai, folder pushup-inbox comes back (docs/sync.md)")


