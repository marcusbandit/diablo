def receipts(env=None, days=14, stop=None, tab="overview"):
    entries = read_log()
    cfg = load_config()
    extra = challenge_args(challenge(cfg, entries)) if challenge_on(cfg) else []
    return overlay(["--graph", "--page", str(RECEIPT_TABS.index(tab) + 1), "--streak", str(day_streak(entries)), *extra,
                    *record_args(entries, max(7, min(60, days)))], env, stop=stop)


def after_receipts(answer, env=None, stop=None):
    """The receipts' buttons: a set now, or logging training. Returns "stopped" when the screen
    locked while one of them was up."""
    if answer == "now":
        cmd_now(None)
    elif answer == "add":
        return cmd_add(None, env, stop)
    return answer


