def describe_challenge(c):
    late = time.time() > c["deadline"]
    lines = [f"day        {c['day']} of {c['days']}, started {c['start']}",
             f"push-ups   {c['done']} of {c['target']} today, {c['left']} to go"
             + (f", past {fmt_clock(c['deadline'])}: sets keep coming while you're up" if late else f" by {fmt_clock(c['deadline'])}")
             if c["left"] and not c["trained"] else f"push-ups   {c['done']} today, target {c['target']} done. Every set now is extra."
             if not c["trained"] else f"push-ups   trained today ({', '.join(c['trained'])}): no cards until tomorrow, "
                                      f"{c['done']} of {c['target']} if you want them anyway (pushup now)",
             f"feet up    {'on: decline push-ups first, plain ones on Tab' if c['feet_up'] else 'off until you say so (pushup challenge feet-up on)'}",
             f"bulgarians {c['bss']['sets']} of {c['bss']['cap']} sets today, {c['bss']['goal']} each leg a set",
             (f"rows       {c['rows']['sets']} of {c['rows']['cap']} sets today at the table edge, up to {c['rows']['goal']} a set"
              if c["rows"]["cap"] else "rows       off (pushup challenge rows on)"),
             (f"stretches  every {load_config()['challenge_stretch_every']} cards once the target is in, David's: "
              f"{', '.join(challenge_stretches(None))}" if c["stretching"] else "stretches  off (pushup stretches on)")]
    if c["target"] < c.get("usual_target", c["target"]):
        lines.insert(2, f"eased      {c['target']} instead of {c['usual_target']}, your {c.get('eased_by') or 'chest and arms'} hurt")
    if not c["started"]:
        lines.append("today      not started: it begins when you're back after a night away")
    return "\n".join(lines)


