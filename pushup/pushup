def parse_sets(text):
    """'10' is one set of 10, '3x10' (or 3*10, 3×10) three of them: (sets, reps), or None."""
    m = re.fullmatch(r"(?:(\d{1,2})\s*[x*×]\s*)?(\d{1,4})", text.strip().lower())
    return (int(m[1] or 1), int(m[2])) if m else None


def log_sets(exercise, reps, sets=1, source=None):
    """Sets done on your own, each its own entry, so a day still counts sets."""
    extra = {"source": source} if source else {}
    for i in range(sets):
        log_event(refresh=i == sets - 1, did=reps, exercise=exercise, result="manual", **extra)


def cmd_log(args):
    amount = parse_sets(args.reps)
    if not amount or amount[1] < 1 or amount[0] < 1:
        raise SystemExit("pushup: log how many you did, like 'pushup log 15', 'pushup log 20 squats' or 'pushup log 3x10 rows'")
    sets, reps = amount
    sets = args.sets or sets
    if not 1 <= sets <= 10:
        raise SystemExit("pushup: 1 to 10 sets at a time")
    known = list(dict.fromkeys([*EXERCISES, *STRETCHES, *load_config()["exercises"]]))
    exercise = catalog.find(" ".join(args.exercise), known) if args.exercise else "push-ups"
    if not exercise:
        typed = " ".join(args.exercise)
        close = catalog.candidates(typed, known)
        raise SystemExit(f"pushup: '{typed}' could be {', '.join(close)}" if close else
                         f"pushup: no exercise called '{typed}'. These exist: {', '.join(known)}")
    log_sets(exercise, reps, sets)
    what = (f"{sets} sets of " if sets > 1 else "") + catalog.describe_set(exercise, reps)
    print(f"Logged {what}. Today: {day_line(done_on(today()))}.")


def cmd_train(args):
    if args.activity not in ACTIVITIES:
        raise SystemExit(f"pushup: no activity called '{args.activity}'. These exist: {', '.join(ACTIVITIES)}")
    if not re.fullmatch(r"\d+\s*[mh]?", args.duration):
        raise SystemExit(f"pushup: can't read '{args.duration}', try 45m, 90m or 2h")
    minutes = parse_duration(args.duration) // 60
    if minutes < 1:
        raise SystemExit("pushup: how long, like 'pushup train climbing 90m' or '2h'")
    log_session(args.activity, minutes, args.effort, 1 if args.yesterday else 0)
    print(f"Logged {catalog.describe({'activity': args.activity, 'minutes': minutes, 'effort': args.effort})}"
          f"{' yesterday' if args.yesterday else ''}.")
    if challenge_on(load_config()):
        if not args.yesterday and trained_on(today(), read_log()):
            print("That's today's training. No more cards until tomorrow.")
        return
    rest = catalog.resting(read_log(), time.time())
    if rest:
        what = "Stretches only" if stretching_on(load_config()) else "No cards"
        print(f"{what} until {dt.datetime.fromtimestamp(rest[0]):%a %H:%M}. Rest up.")


