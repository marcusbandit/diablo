def cmd_stats(args):
    entries = read_log()
    now = today()
    total = 0
    print("day         sets  skipped  done")
    for i in range(args.days - 1, -1, -1):
        day = now - dt.timedelta(days=i)
        sets = done_on(day, entries)
        skipped = sum(1 for e in entries if e.get("result") in ("skip", "done") and did(e) == 0
                      and day_of(e["ts"]) == day)
        total += len(sets)
        print(f"{day:%a %d %b}  {len(sets):4d}  {skipped:7d}  {', '.join(catalog.day_lines(sets))}")
    print(f"total       {total:4d}")


def parse_duration(text):
    if text in ("tomorrow", "today"):
        tomorrow = dt.datetime.combine(dt.date.today() + dt.timedelta(days=1), dt.time(6))
        return tomorrow.timestamp() - time.time()
    m = re.fullmatch(r"(\d+)\s*([mh]?)", text)
    if not m:
        raise SystemExit(f"pushup: can't read '{text}', try 30m, 2h or tomorrow")
    return int(m[1]) * (3600 if m[2] == "h" else 60)


def parse_hurt(words):
    """'left triceps right chest' or 'arms': {part: spots}. A side word goes with the muscle after
    it; a muscle with no side is both. A part word ('arms', 'back') names the part alone."""
    out, whole, side, i = {}, set(), None, 0
    while i < len(words):
        w = words[i]
        two = f"{w} {words[i + 1]}" if i + 1 < len(words) else ""
        if w in ("left", "right", "both"):
            side, i = w, i + 1
            continue
        muscle = two if two in catalog.PART_OF else w if w in catalog.PART_OF else None
        if muscle is None and w + "s" in catalog.PART_OF:
            muscle = w + "s"  # 'tricep', 'bicep', 'quad'
        if muscle is None and w == "calf":
            muscle = "calves"
        if muscle:
            sides = ("left", "right") if side in (None, "both") else (side,)
            out.setdefault(catalog.PART_OF[muscle], []).extend([muscle, s] for s in sides)
            side, i = None, i + (2 if muscle == two else 1)
            continue
        part = catalog.part_named(w)
        if part is None:
            raise SystemExit(f"pushup: '{w}' isn't a body part I know. Try arms, left triceps, chest, back, legs or core.")
        whole.add(part)
        side, i = None, i + 1
    if side:
        raise SystemExit(f"pushup: {side} what? Name the muscle after it: pushup hurt {side} triceps")
    for part in whole:
        out[part] = []  # 'arms left triceps' is all of the arms
    return out


def cmd_hurt(args):
    """pushup hurt arms: that part hurts, ease off it. pushup hurt off arms, or off alone for all."""
    words = [w.lower().replace("_", " ") for w in args.where]
    healed = bool(words) and words[0] in ("off", "better", "fine")
    words = words[1:] if healed else words
    entries = read_log()
    if not words and not healed:
        hurts = hurting(entries)
        if not hurts:
            print("Nothing hurts on record. Say where: pushup hurt arms (or chest, back, legs, core).")
        for p, h in hurts.items():
            print(f"{h['name']}: goals at {round(h['keep'] * 100)}%, "
                  + ("said yesterday" if h["yesterday"] else "since today" if h["streak"] == 1 else f"{h['streak']} days in a row"))
        return
    said = parse_hurt(words) if words else {p: [] for p in hurting(entries)}
    parts = list(said)
    for p in parts:
        log_hurt(p, healed, said[p])
    entries = read_log()
    for p in parts:
        name = catalog.spots_text(said[p]) or catalog.PART_NAMES[p]
        if healed:
            print(f"Good to hear. Your {name} get the usual goals again.")
            continue
        h = hurt_on(entries, p, today())
        if h["streak"] >= 4:
            print(f"{h['streak']} days in a row now. That's not soreness from training any more. Rest them "
                  f"(pushup pause tomorrow) or have them looked at. Goals stay at {round(h['keep'] * 100)}%.")
        elif h["streak"] == 3:
            print(f"Third day. Only a little less this time: goals at {round(h['keep'] * 100)}%.")
        elif h["worked"]:
            print(f"Fair, they earned it: {h['reps']} reps on your {name} these last few days. "
                  f"Goals at {round(h['keep'] * 100)}% today, and a bit less tomorrow too.")
        else:
            print(f"Noted. Your {name} have had an easy few days, so goals at {round(h['keep'] * 100)}% today.")
    cfg = load_config()
    if challenge_on(cfg) and "push" in parts and not healed:
        c = challenge(cfg, entries)
        print(f"Today's push-ups: {c['target']} instead of {c['usual_target']}, {c['done']} done.")


